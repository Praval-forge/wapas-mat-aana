{
  "openapi": "3.0.3",
  "info": {
    "title": "Wapas Mat Aana API",
    "version": "2.1.0",
    "description": "Wapas Mat Aana. API-key-authenticated, tenant-isolated COD risk scoring with human-final decisions on a five-band ladder (LOW 0-29 \u20b90 no confirmation; MEDIUM 30-49 \u20b90 free YES confirmation; HIGH 50-69 \u20b949; VERY_HIGH 70-84 \u20b999; EXTREME 85-100 \u20b9149, upfront amounts adjusted against the amount due on delivery and never above the order value). One exception: silent upfront-request orders may auto-cancel after 24h when the per-brand toggle is ON; any human action or real buyer reply preempts it. Endpoints tagged 'Demo (unauthenticated sandbox)' belong to the shared public demo: buyer links are bearer capabilities, the Shopify route is a simulator (not an authenticated Shopify webhook), payments are simulated and no money is collected. Free-tier hosting storage is ephemeral."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Orders"
    },
    {
      "name": "Policy"
    },
    {
      "name": "Webhooks"
    },
    {
      "name": "Usage"
    },
    {
      "name": "Meta"
    },
    {
      "name": "Demo (unauthenticated sandbox)",
      "description": "Public shared demo only. Fake data. No authentication except bearer buyer links. Not for production integrations; use /v1 with an API key."
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        }
      },
      "OrderInput": {
        "type": "object",
        "required": [
          "buyer_name",
          "pin",
          "address"
        ],
        "properties": {
          "buyer_name": {
            "type": "string",
            "maxLength": 80
          },
          "phone": {
            "type": "string",
            "description": "10-digit Indian mobile; used to look up buyer history"
          },
          "pin": {
            "type": "string",
            "pattern": "^[1-9]\\d{5}$"
          },
          "city": {
            "type": "string",
            "description": "Display only; never used in scoring (fairness)"
          },
          "address": {
            "type": "string",
            "maxLength": 500
          },
          "product": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "description": "Order value in INR"
          },
          "external_id": {
            "type": "string",
            "description": "Your own order id, echoed back and queryable"
          },
          "payment_mode": {
            "type": "string",
            "enum": [
              "cod",
              "prepaid"
            ]
          },
          "past_orders": {
            "type": "integer",
            "minimum": 0
          },
          "past_returns": {
            "type": "integer",
            "minimum": 0
          },
          "orders_same_phone_today": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "CG-1004"
          },
          "external_id": {
            "type": "string",
            "nullable": true
          },
          "buyer_name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "pin": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "product": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "risk": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ],
            "description": "Coarse tier (HIGH covers scores above mediumMax). Use risk_band for the five-band ladder."
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING_REVIEW",
              "SHIPPED",
              "HOLD",
              "CANCELLED"
            ],
            "description": "Every order starts PENDING_REVIEW. Only a human sets SHIPPED/HOLD/CANCELLED, except the 24h silent upfront auto-cancel (decision_by=system)."
          },
          "whatsapp": {
            "type": "string",
            "nullable": true
          },
          "buyer_reply": {
            "type": "string",
            "nullable": true,
            "enum": [
              "confirm",
              "paid",
              "cancel",
              "no_reply",
              "wrong_address",
              "address_fixed",
              null
            ]
          },
          "overridden": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "steps": {
            "type": "object",
            "description": "pin_check, history, address_check and score (with points breakdown)"
          },
          "decision": {
            "type": "string",
            "nullable": true
          },
          "decision_by": {
            "type": "string",
            "enum": [
              "human",
              "system"
            ],
            "nullable": true
          },
          "suggested_action": {
            "type": "string"
          },
          "commitment_fee_rs": {
            "type": "number",
            "description": "Upfront amount requested by the band; never above the order value; frozen once a payment is recorded"
          },
          "risk_band": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "VERY_HIGH",
              "EXTREME"
            ]
          },
          "risk_band_label": {
            "type": "string"
          },
          "pay_now_rs": {
            "type": "number",
            "description": "What the buyer is asked to pay now (0 for LOW/MEDIUM/prepaid)"
          },
          "balance_at_delivery_rs": {
            "type": "number",
            "description": "Order value minus the upfront amount (or recorded payment)"
          },
          "decided_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "source": {
            "type": "string",
            "enum": [
              "seed",
              "dashboard",
              "api",
              "csv",
              "storefront",
              "shopify_demo"
            ]
          },
          "orders_same_phone_today": {
            "type": "integer",
            "description": "Orders from this phone for this tenant on the same IST calendar day"
          },
          "buyer_path": {
            "type": "string",
            "example": "/buyer/3Jx...",
            "description": "Bearer capability: anyone holding it can view the narrow buyer page and record buyer evidence. Share only with the buyer."
          },
          "buyer_url": {
            "type": "string",
            "description": "buyer_path on the trusted public base (PUBLIC_BASE_URL, RENDER_EXTERNAL_URL or the request origin)"
          },
          "payment": {
            "type": "object",
            "nullable": true,
            "description": "Simulated payment record. No money is collected.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "upfront",
                  "full_online"
                ]
              },
              "amount_rs": {
                "type": "number"
              },
              "discount_rs": {
                "type": "number"
              },
              "balance_due_rs": {
                "type": "number"
              },
              "app": {
                "type": "string"
              },
              "reference": {
                "type": "string"
              },
              "simulated": {
                "type": "boolean",
                "enum": [
                  true
                ]
              },
              "recorded_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "Policy": {
        "type": "object",
        "properties": {
          "lowMax": {
            "type": "integer",
            "default": 29
          },
          "mediumMax": {
            "type": "integer",
            "default": 49
          },
          "weights": {
            "type": "object",
            "properties": {
              "repeatReturner": {
                "type": "integer",
                "default": 40,
                "minimum": 0,
                "maximum": 100
              },
              "onePastReturn": {
                "type": "integer",
                "default": 25,
                "minimum": 0,
                "maximum": 100
              },
              "addressBad": {
                "type": "integer",
                "default": 20,
                "minimum": 0,
                "maximum": 100
              },
              "addressVague": {
                "type": "integer",
                "default": 20,
                "minimum": 0,
                "maximum": 100
              },
              "pinHigh": {
                "type": "integer",
                "default": 30,
                "minimum": 0,
                "maximum": 100
              },
              "pinMedium": {
                "type": "integer",
                "default": 15,
                "minimum": 0,
                "maximum": 100
              },
              "loyalBuyer": {
                "type": "integer",
                "default": 15,
                "minimum": 0,
                "maximum": 100
              },
              "unknownPin": {
                "type": "integer",
                "default": 10,
                "minimum": 0,
                "maximum": 100
              },
              "shortAddress": {
                "type": "integer",
                "default": 10,
                "minimum": 0,
                "maximum": 100
              },
              "noHouseNumber": {
                "type": "integer",
                "default": 5,
                "minimum": 0,
                "maximum": 100
              },
              "noLandmark": {
                "type": "integer",
                "default": 5,
                "minimum": 0,
                "maximum": 100
              },
              "fakePhone": {
                "type": "integer",
                "default": 20,
                "minimum": 0,
                "maximum": 100
              },
              "junkName": {
                "type": "integer",
                "default": 20,
                "minimum": 0,
                "maximum": 100
              },
              "firstTimeBuyer": {
                "type": "integer",
                "default": 10,
                "minimum": 0,
                "maximum": 100
              },
              "highValue": {
                "type": "integer",
                "default": 10,
                "minimum": 0,
                "maximum": 100
              },
              "phoneFrequency": {
                "type": "integer",
                "default": 15,
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "reminderAfterHours": {
            "type": "integer",
            "default": 12
          },
          "mediumSilentAfterHours": {
            "type": "integer",
            "default": 24
          },
          "highSilentAfterHours": {
            "type": "integer",
            "default": 24
          },
          "highSilentAction": {
            "type": "string",
            "enum": [
              "cancel",
              "hold"
            ],
            "default": "cancel"
          },
          "veryHighMin": {
            "type": "integer",
            "default": 70
          },
          "extremeMin": {
            "type": "integer",
            "default": 85
          },
          "feeHigh": {
            "type": "integer",
            "default": 49
          },
          "feeVeryHigh": {
            "type": "integer",
            "default": 99
          },
          "feeExtreme": {
            "type": "integer",
            "default": 149
          },
          "autoCancelSilent": {
            "type": "boolean",
            "default": true
          },
          "highValueThreshold": {
            "type": "integer",
            "default": 2000
          },
          "frequencyThreshold": {
            "type": "integer",
            "default": 2
          }
        }
      },
      "Webhook": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "order.scored",
                "order.rescored",
                "order.reply_received",
                "order.reply_cleared",
                "order.review_required",
                "order.reminded",
                "order.status_changed",
                "order.overridden",
                "order.decision_undone",
                "order.auto_cancelled"
              ]
            }
          },
          "active": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/v1/meta": {
      "get": {
        "tags": [
          "Meta"
        ],
        "summary": "Service metadata, plan limits and webhook event names",
        "security": [],
        "responses": {
          "200": {
            "description": "Metadata"
          }
        }
      }
    },
    "/v1/orders": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Ingest a order: validate, score on all signals, route",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The scored, routed order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited or monthly quota exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "List orders (filterable by status, risk, external_id)",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "risk",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "external_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Orders for this tenant"
          }
        }
      }
    },
    "/v1/orders/score": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Stateless scoring preview (nothing stored, no quota used)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Score, tier, reasons and per-signal points breakdown"
          }
        }
      }
    },
    "/v1/orders/{id}": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Get one order by CG id or your external_id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/orders/{id}/buyer-reply": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Record buyer evidence (never ships, holds or cancels)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "reply"
                ],
                "properties": {
                  "reply": {
                    "type": "string",
                    "enum": [
                      "confirm",
                      "paid",
                      "cancel",
                      "no_reply",
                      "wrong_address",
                      "address_fixed",
                      "clear"
                    ],
                    "description": "confirm = buyer replied YES; paid = upfront amount reported paid (records a simulated payment once); cancel = buyer asked to cancel (suggestion only); wrong_address; address_fixed; no_reply = silence (does not prevent the auto-cancel); clear = seller clears a mistaken reply (refused once a payment is recorded; counts as a human review)."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated order"
          },
          "400": {
            "description": "Workflow error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/orders/{id}/actions": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Human seller action: ship | hold | cancel | override | undo",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "ship",
                      "hold",
                      "cancel",
                      "override",
                      "undo"
                    ]
                  },
                  "to": {
                    "type": "string",
                    "enum": [
                      "ship",
                      "hold",
                      "cancel"
                    ],
                    "description": "required when action=override"
                  },
                  "note": {
                    "type": "string",
                    "description": "required when action=override; kept in the audit log"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated order"
          },
          "400": {
            "description": "Workflow error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Human-final action: ship, hold, cancel; override requires a note; undo clears the decision and returns the order to PENDING_REVIEW (audited, order.decision_undone webhook) and never triggers an automatic decision. Any of these preempts the silent auto-cancel."
      }
    },
    "/v1/seller-rules": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Fairness guard: blanket group rules are always refused (422)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "422": {
            "description": "Refused, with explanation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/policy": {
      "get": {
        "tags": [
          "Policy"
        ],
        "summary": "Effective scoring/routing policy for your tenant",
        "responses": {
          "200": {
            "description": "The policy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Policy"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Policy"
        ],
        "summary": "Patch policy overrides (thresholds, weights, silence timings)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Policy"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New effective policy"
          },
          "422": {
            "description": "Invalid policy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/webhooks": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Register a webhook. The signing secret is returned exactly once.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "events": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "order.scored",
                        "order.rescored",
                        "order.reply_received",
                        "order.reply_cleared",
                        "order.review_required",
                        "order.reminded",
                        "order.status_changed",
                        "order.overridden",
                        "order.decision_undone",
                        "order.auto_cancelled"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created; includes `secret` once"
          },
          "402": {
            "description": "Plan webhook cap reached"
          }
        }
      },
      "get": {
        "tags": [
          "Webhooks"
        ],
        "summary": "List webhooks (secrets are never returned)",
        "responses": {
          "200": {
            "description": "Webhooks"
          }
        }
      }
    },
    "/v1/webhooks/{id}": {
      "delete": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Deactivate a webhook",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deactivated"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/v1/webhooks-deliveries": {
      "get": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Recent delivery attempts (status, retries, latency)",
        "responses": {
          "200": {
            "description": "Delivery log"
          }
        }
      }
    },
    "/v1/usage": {
      "get": {
        "tags": [
          "Usage"
        ],
        "summary": "Your plan limits and per-month usage",
        "responses": {
          "200": {
            "description": "Usage by month"
          }
        }
      }
    },
    "/v1/settings": {
      "get": {
        "tags": [
          "Policy"
        ],
