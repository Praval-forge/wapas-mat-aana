# Copy to .env and fill in. .env is git-ignored - never commit a real key.

# Optional. Without it the app runs in DEMO MODE (rule-based address check, no network calls).
ANTHROPIC_API_KEY=

# Optional. Defaults to 3000.
PORT=3000

# Optional. Where orders, tenants, keys and webhooks persist. Use ":memory:" for tests.
CODGUARD_DATA_FILE=./data/codguard.json

# Optional but SET THIS before exposing the app. Protects the admin console (/admin/api).
# The default "demo-admin-key" is for the public sandbox demo only.
CODGUARD_ADMIN_KEY=demo-admin-key

# Optional but recommended when deployed. Trusted base for buyer links in messages
# (e.g. https://your-app.onrender.com). On Render, RENDER_EXTERNAL_URL is used if this is empty.
PUBLIC_BASE_URL=

# Optional. Per-IP requests/minute on public demo routes that create or change data. Default 30.
CODGUARD_DEMO_RATE_LIMIT=30
